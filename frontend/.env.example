VITE_API_BASE_URL=/api/v1
VITE_ARA_API_URL=http://localhost:5000

# Auth mode: "dev" for local development (backend mock user), "cognito" for production
VITE_AUTH_MODE=dev
# Migration Refinery Backend Configuration
VITE_MIGRATION_REFINERY_API_URL=http://localhost:8080

# Cognito config (only needed when VITE_AUTH_MODE != dev)
# VITE_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
# VITE_COGNITO_CLIENT_ID=your-frontend-client-id
# VITE_COGNITO_REGION=us-east-1
# VITE_COGNITO_DOMAIN=dev-unified-orchestrator-auth

# CCoE PKCE OAuth (only needed when VITE_AUTH_MODE != dev)
# VITE_AUTH_DOMAIN=https://uno-auth.att.nmunibac.people.aws.dev
# VITE_CLIENT_ID=your-cognito-app-client-id
# VITE_REDIRECT_URI=https://your-app-url/callback
# VITE_LOGOUT_URI=https://your-app-url
# VITE_OAUTH_SCOPE=openid profile email
