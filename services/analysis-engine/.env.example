# Application Configuration
# Set to "development" for local dev (bypasses auth, uses mock user via DEV_PERSONA).
# MUST be "production" in deployed environments — dev mode disables all authentication.
APP_ENV=production
HOST=127.0.0.1
PORT=5000

# AWS Configuration
AWS_REGION=us-east-1
USE_AWS_PROFILE=true
AWS_PROFILE=your-aws-profile

# AWS Bedrock
BEDROCK_MODEL_ID=us.amazon.nova-2-pro-preview-20251202-v1:0

# DynamoDB Tables
APPLICATIONS_TABLE=haf-uno-data-plane-dev-applications
RISK_ASSESSMENTS_TABLE=haf-ara-dev-risk-assessments
PATTERNS_TABLE=haf-ara-dev-wave-patterns
TARGET_COMPONENTS_TABLE=haf-uno-data-plane-dev-target-components
PROCESSING_TASKS_TABLE=haf-uno-data-plane-dev-processing-tasks
APP_COMPONENTS_TABLE=haf-uno-data-plane-dev-app-components
DEFAULT_OS_VERSION_TABLE=haf-uno-data-plane-dev-default-os-versions

# S3
S3_ARA_BUCKET=haf-ara-dev-assets-ACCOUNT_ID
S3_UNO_DP_BUCKET=haf-uno-data-plane-dev-assets-ACCOUNT_ID

# Dev mode persona (privileged or viewer)
DEV_PERSONA=privileged

# GitHub (optional, for SCM analysis)
GITHUB_TOKEN=

# Logging
LOG_LEVEL=INFO

# ATX Configuration
ATX_TRANSFORMATION_NAME=AWS/comprehensive-codebase-analysis
ATX_SHELL_TIMEOUT=36000
ATX_RUN_MODE=local
ATX_COMBINED_MAX_RESUME_ATTEMPTS=5
