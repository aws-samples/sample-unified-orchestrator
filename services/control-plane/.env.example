# App Configuration
# Set to "development" for local dev (bypasses auth, uses mock user via DEV_PERSONA).
# MUST be "production" in deployed environments — dev mode disables all authentication.
APP_ENV=production

# Server Configuration
PORT=6001

# CORS Configuration
CORS_ORIGINS=http://localhost:3000

# AWS Configuration
AWS_REGION=us-east-1
AWS_PROFILE=default

# DynamoDB Table Names
APPLICATIONS_TABLE=haf-uno-control-plane-dev-applications
APP_COMPONENTS_TABLE=haf-uno-control-plane-dev-app-components

# Pod Access (temporary — will be removed when Migration Refinery APIs are ready)
POD_ACCESS_TABLE_NAME=haf-uno-data-plane-dev-pod-user-applications

# Cognito (for production logout flow)
# COGNITO_USER_POOL_DOMAIN=your-domain
# COGNITO_ALB_CLIENT_ID=your-client-id
# APP_URL=https://your-app-url

# Cognito PKCE OAuth (CCoE pattern)
COGNITO_USER_POOL_ID=
COGNITO_REGION=us-east-1

# Logging
LOG_LEVEL=INFO
